# --- 必填(只有這兩個!)-------------------------------------------------
# Discord Developer Portal -> 你的應用程式 -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> General Information -> Application ID
DISCORD_APP_ID=

# --- 選填 ---------------------------------------------------------------
# 測試用:填你的伺服器 ID,斜線指令會立刻出現(不填 = 全域,最久約 1 小時才生效)
DISCORD_GUILD_ID=

# 資料庫(db.json)、玩家回報、角色、情報等資料存放的資料夾
# DATA_DIR=data

# ---- 情報(/更新情報)-------------------------------------------------------
# 每天幾點自動收集情報(24 小時制,台灣時間)
# NEWS_DAILY_AT=06:00
# 時區:比 UTC 快幾小時(台灣 = 8)。影響「每天」「今天簽到」的日界線
# TZ_OFFSET_HOURS=8
# 每天收集完,把新的情報貼到這個頻道(頻道 ID)。不填 = 不自動貼,只能 /更新情報 查
# NEWS_CHANNEL_ID=
# /更新情報 時,距離上次抓取超過幾分鐘才會重新去網站抓(避免對網站太頻繁)
# NEWS_MIN_REFRESH_MINUTES=30
# 讓管理員可以把某些頻道的貼文當成情報(例如追蹤了其他社群公告的頻道)。
# 要同時到 Discord Developer Portal -> Bot 開啟 Message Content Intent
# ENABLE_CHANNEL_INTEL=1

# ================= 以下是「選用」的 AI 功能,要付費,不想用就整段留空 =================
# 填了才會啟用 /問答,並讓 /攻略 與 @機器人 改由 AI 回答。https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI 可以查的網站(逗號分隔,不要加 https://);/攻略 的搜尋連結也用這份清單
# ARTALE_SOURCES=artalemaplestory.com,forum.gamer.com.tw,dcard.tw,ptt.cc,uptogo.com.tw
# ARTALE_DB_DOMAINS=artalemaplestory.com
# 只允許在這些頻道使用 AI(頻道 ID,逗號分隔)。不填 = 所有頻道
# ALLOWED_CHANNEL_IDS=
# MAX_SEARCHES=3
# MAX_FETCHES=3
# MAX_OUTPUT_TOKENS=1500
# MAX_PAGE_TOKENS=12000
# REQUEST_TIMEOUT_SECONDS=90
# RATE_LIMIT_PER_10_MIN=5
# RATE_LIMIT_PER_DAY=40
# MAX_CONCURRENT=3
