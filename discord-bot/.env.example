# --- 必填(只有這兩個!)-------------------------------------------------
# Discord Developer Portal -> 你的應用程式 -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> General Information -> Application ID
DISCORD_APP_ID=

# --- 選填 ---------------------------------------------------------------
# 測試用:填你的伺服器 ID,斜線指令會立刻出現(不填 = 全域,最久約 1 小時才生效)
DISCORD_GUILD_ID=

# 資料庫(db.json)和遊戲分數存放的資料夾
# DATA_DIR=data

# 音樂:設 0 關閉放歌功能
# ENABLE_MUSIC=1
# 放音樂檔的資料夾(mp3 / ogg / flac / wav / m4a…)
# MUSIC_DIR=music
# 網路電台:名稱=串流網址,用逗號隔開。只有你列在這裡的電台能播
# RADIO_STREAMS=電台一=https://example.com/stream,電台二=https://example.com/live

# 只允許在這些頻道使用 AI(頻道 ID,逗號分隔)。不填 = 所有頻道
# ALLOWED_CHANNEL_IDS=

# ================= 以下是「選用」的 AI 功能,要付費,不想用就整段留空 =================
# 填了才會啟用 /ask,並讓 /guide 與 @機器人 改由 AI 回答。https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI 可以查的網站(逗號分隔,不要加 https://);/guide 的搜尋連結也用這份清單
# ARTALE_SOURCES=artalemaplestory.com,forum.gamer.com.tw,dcard.tw,ptt.cc,uptogo.com.tw
# ARTALE_DB_DOMAINS=artalemaplestory.com
# MAX_SEARCHES=3
# MAX_FETCHES=3
# MAX_OUTPUT_TOKENS=1500
# MAX_PAGE_TOKENS=12000
# REQUEST_TIMEOUT_SECONDS=90
# RATE_LIMIT_PER_10_MIN=5
# RATE_LIMIT_PER_DAY=40
# MAX_CONCURRENT=3
