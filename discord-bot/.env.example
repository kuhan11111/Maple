# --- 必填 ---------------------------------------------------------------
# Discord Developer Portal -> 你的應用程式 -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> General Information -> Application ID
DISCORD_APP_ID=
# https://console.anthropic.com -> API Keys(並在 Console 啟用 web search)
ANTHROPIC_API_KEY=

# --- 選填 ---------------------------------------------------------------
# 測試用:填你的伺服器 ID,斜線指令會立刻出現(不填 = 全域,最久約 1 小時才生效)
DISCORD_GUILD_ID=

# 模型。省錢可改 claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# 機器人可以查的網站(逗號分隔,不要加 https://)。不填 = 預設清單
# ARTALE_SOURCES=artalemaplestory.com,forum.gamer.com.tw,dcard.tw,ptt.cc,uptogo.com.tw
# 其中哪些是掉落 / 怪物 / 地圖資料庫(回答這類問題時優先查)
# ARTALE_DB_DOMAINS=artalemaplestory.com

# 只允許在這些頻道使用(頻道 ID,逗號分隔)。不填 = 所有頻道
# ALLOWED_CHANNEL_IDS=

# 每次查詢的上限(控制費用)
# MAX_SEARCHES=3
# MAX_FETCHES=3
# MAX_OUTPUT_TOKENS=1500
# MAX_PAGE_TOKENS=12000
# REQUEST_TIMEOUT_SECONDS=90

# 每位使用者的限流、同時處理的查詢數
# RATE_LIMIT_PER_10_MIN=5
# RATE_LIMIT_PER_DAY=40
# MAX_CONCURRENT=3
