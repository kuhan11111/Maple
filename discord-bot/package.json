{
  "name": "artale-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord bot that answers Artale questions (drops, guides) by searching a curated list of sites",
  "scripts": {
    "start": "node src/bot.js",
    "register": "node src/register.js",
    "test": "node --test test/*.test.mjs",
    "check": "node src/check.js",
    "import": "node src/lookup/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
